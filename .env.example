DATABASE_URL="postgresql://user:password@localhost:5432/vye"

# REQUIRED: min 32 chars — generate with: openssl rand -hex 32
JWT_SECRET="change-me-in-production"
JWT_EXPIRY="15m"

# REQUIRED: min 16 chars — copy from RevenueCat dashboard > Webhooks
REVENUECAT_WEBHOOK_SECRET="replace-with-revenuecat-webhook-secret"

# CORS: comma-separated allowed origins (leave empty to block all cross-origin in production)
CORS_ORIGINS=""

NODE_ENV="development"

AWS_REGION="us-east-1"
S3_BUCKET="vye-storage"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="mock-r2-access-key-id"
S3_SECRET_ACCESS_KEY="mock-r2-secret-access-key"
